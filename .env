# ── Authentification application ──────────────────────────────────────────────
USERNAME=admin
PASSWORD=admin
SECRET_KEY=lpo_ai_secret_change_in_production_2024

# ── Base de données ───────────────────────────────────────────────────────────
# dev  : sqlite:///data/sensitive_areas.db (laisser vide pour ce défaut)
# prod : PostgreSQL. `postgres://` et `postgresql://` sont acceptés (normalisés
#        vers psycopg 3). Ajouter ?sslmode=require si la base l'exige.
# DATABASE_URL=postgresql://lpo_ro:password@db.interne:5432/lpo?sslmode=require
DATABASE_URL=sqlite:///data/sensitive_areas.db
DB_READ_ONLY=true
DB_MAX_ROWS=5000
# PostgreSQL uniquement (sans effet sur SQLite) :
# DB_SCHEMA=lpo                 # borne le search_path à lpo,public
# DB_APPLICATION_NAME=lpo-data-ai
# DB_STATEMENT_TIMEOUT_MS=15000
# DB_LOCK_TIMEOUT_MS=3000
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5

# ── IA (changement de provider = AI_PROVIDER + AI_MODEL) ──────────────────────
AI_PROVIDER=anthropic
AI_MODEL=claude-haiku-4-5-20251001
AI_TEMPERATURE=0.0

# Renseigner uniquement la clé du provider actif. Ces valeurs sont les défauts :
# l'interface web (bouton « Configuration ») peut les surcharger pour la durée du
# processus, sans redémarrage et sans jamais renvoyer la clé au navigateur.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# MISTRAL_API_KEY=
# GROQ_API_KEY=

# ── Interface web : configuration à chaud ────────────────────────────────────
# on (défaut) : modèle et cible MCP modifiables depuis l'interface.
# url-only    : seule la cible HTTP est modifiable (aucune commande locale).
# off         : configuration figée par cet environnement (recommandé en prod).
# LPO_WEB_SETTINGS=url-only
